# =============================================================================
# Copy this file to `.env` on the droplet and fill in real values.
# `docker compose` auto-loads `.env` from the same directory.
# Do NOT commit the real .env (it is git-ignored).
# =============================================================================

# ---- Deployment / Caddy (used by docker-compose + Caddyfile) ----
DOMAIN=vertex.dsce.club
LETSENCRYPT_EMAIL=you@example.com

# ---- NextAuth ----
# NEXTAUTH_URL must be the public https URL of the site.
NEXTAUTH_URL=https://vertex.dsce.club
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- Database (MongoDB Atlas, external) ----
# Atlas SRV connection string. Prisma+MongoDB requires a replica set (Atlas provides one).
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority"

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Gmail via nodemailer) ----
EMAIL_USER=
EMAIL_PASS=
SMTP_USER=

# ---- Razorpay ----
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- reCAPTCHA ----
RECAPTCHA_SECRET_KEY=

# ---- Upstash Redis (rate limiting) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# NEXT_PUBLIC_* are baked into the client bundle at BUILD time.
# They are read as docker-compose build args, so they must be set BEFORE `up --build`.
# =============================================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
