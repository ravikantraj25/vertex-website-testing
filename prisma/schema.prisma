datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  usn          String                  @unique
  emailId      String                  @unique
  phoneNo      String
  
  application  RecruitmentApplication? 

}

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  usn          String   @unique
  emailId      String   @unique
  phoneNo      String

  achievements Achievement[]
  members      Member[]
  applications RecruitmentApplication[]
  contacts     ContactReceiving[]
  
}

model RecruitmentApplication {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  usn     String
  emailId String
  phoneNo String
  team    String

  userId  String @unique @db.ObjectId
  user    User   @relation(fields: [userId], references: [id])
  
  adminId String? @db.ObjectId
  admin   Admin?  @relation(fields: [adminId], references: [id])
}

model Member {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  usn       String   @unique
  emailId   String   @unique
  phoneNo   String
  team      String[] 
  role      String[]
  // Added image field for Cloudinary URL
  imageUrl  String?  

  adminId   String?  @db.ObjectId
  admin     Admin?   @relation(fields: [adminId], references: [id])
}

model Achievement {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  participants String
  team         String
  rank         String
  competition  String
  year         Int

  adminId      String? @db.ObjectId
  admin        Admin?  @relation(fields: [adminId], references: [id])
}

model ContactReceiving {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  emailId String
  phoneNo String
  // Added message field for the person's inquiry
  message String  

  adminId String? @db.ObjectId
  admin   Admin?  @relation(fields: [adminId], references: [id])
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum EventType {
  SOLO
  TEAM
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RegistrationStatus {
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
}

model Participant {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  usn            String          @unique
  phoneNo        String?
  email          String          
  emailVerified  Boolean         @default(false)
  gender         String
  collegeName    String
  year           String
  department     String
  participations Participation[]
  registrations  Registration[]
  ledTeams       Team[]          @relation("TeamLeader")
  createdAt      DateTime        @default(now())
}

model Event {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  slug           String    @unique
  name           String
  type           EventType
  price          Int             // paise: 10000 = ₹100, 40000 = ₹400
  participations Participation[]
  teams          Team[]
  createdAt      DateTime        @default(now())
}

model Team {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  event        Event           @relation(fields: [eventId], references: [id])
  eventId      String          @db.ObjectId
  leader       Participant     @relation("TeamLeader", fields: [leaderId], references: [id])
  leaderId     String          @db.ObjectId
  members      Participation[]
  createdAt    DateTime        @default(now())

  @@unique([name, eventId])
}

model Participation {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  participant     Participant?  @relation(fields: [participantId], references: [id])
  participantId   String?       @db.ObjectId
  event           Event        @relation(fields: [eventId], references: [id])
  eventId         String       @db.ObjectId
  team            Team?        @relation(fields: [teamId], references: [id])
  teamId          String?      @db.ObjectId
  registration    Registration? @relation(fields: [registrationId], references: [id])
  registrationId  String?       @db.ObjectId
  createdAt       DateTime     @default(now())

  @@unique([participantId, eventId])
}

model Registration {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  participant    Participant        @relation(fields: [participantId], references: [id])
  participantId  String             @db.ObjectId
  participations Participation[]
  payment        Payment?
  status         RegistrationStatus @default(PAYMENT_PENDING)
  createdAt      DateTime           @default(now())
}

model Payment {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  registration        Registration  @relation(fields: [registrationId], references: [id])
  registrationId      String        @unique @db.ObjectId
  razorpayOrderId     String        @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  amount              Int           // total in paise
  currency            String        @default("INR")
  status              PaymentStatus @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}