datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // Your MongoDB connection string goes here
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  usn          String                  @unique
  emailId      String                  @unique
  phoneNo      String
  
  // Relations
  application  RecruitmentApplication? 
  
  // Many-to-many with Event (MongoDB uses arrays of IDs)
  eventIds     String[]                @db.ObjectId
  events       Event[]                 @relation(fields: [eventIds], references: [id])
}

model Admin {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  usn     String @unique
  emailId   String @unique
  phoneNo String

  // Relations
  achievements Achievement[]
  members      Member[]
  applications RecruitmentApplication[]
  contacts     ContactReceiving[]
  events       Event[]
}

model RecruitmentApplication {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  usn     String
  emailId String
  phoneNo String
  team    String

  // Relations
  userId  String @unique @db.ObjectId
  user    User   @relation(fields: [userId], references: [id])
  
  adminId String? @db.ObjectId
  admin   Admin?  @relation(fields: [adminId], references: [id])
}

model Member {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  usn     String   @unique
  emailId String   @unique
  phoneNo String
  team    String[] // Multivalued attribute (perfect for Mongo arrays)
  role    String[]

  adminId String? @db.ObjectId
  admin   Admin?  @relation(fields: [adminId], references: [id])
}

model Event {
  id    String   @id @default(auto()) @map("_id") @db.ObjectId
  venue String
  date  DateTime
  time  String

  // Relations
  userIds String[] @db.ObjectId
  users   User[]   @relation(fields: [userIds], references: [id])

  adminId String?  @db.ObjectId
  admin   Admin?   @relation(fields: [adminId], references: [id])
}

model Achievement {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  participants String
  team         String
  rank         String
  competition  String
  year         Int

  adminId      String? @db.ObjectId
  admin        Admin?  @relation(fields: [adminId], references: [id])
}

model ContactReceiving {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  emailId String
  phoneNo String

  adminId String? @db.ObjectId
  admin   Admin?  @relation(fields: [adminId], references: [id])
}